# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SQL Server connection (local dev: SQL Server Express with Windows Auth)
SQL_SERVER=WOLUCA\SQLEXPRESS
SQL_DATABASE=WineOnboarding

# Multi-tenancy dev bypass: org ID to use when no JWT auth is present.
# Set to the organisation_id of the org you want to test as.
# Phase 2 will replace this with real JWT extraction.
DEV_ORG_ID=1

# Azure SQL Database Configuration (Phase 3 — Azure deployment)
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=
AZURE_SQL_PORT=1433
AZURE_SQL_ENCRYPT=true
