# SQL Server connection (local dev: SQL Server Express with Windows Auth)
SQL_SERVER=WOLUCA\SQLEXPRESS
SQL_DATABASE=WineOnboarding

# Auth0 — backend token validation
# Domain and audience from your Auth0 dashboard
AUTH0_DOMAIN=your-tenant.uk.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier

# Set SKIP_AUTH=true to bypass Auth0 and use DEV_ORG_ID/DEV_USER_ID instead.
# Useful for local dev without needing to log in. Set to false in production.
SKIP_AUTH=false
DEV_ORG_ID=1
DEV_USER_ID=1

# Auth0 — frontend (Vite exposes VITE_ prefixed vars to the browser)
VITE_AUTH0_DOMAIN=your-tenant.uk.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://your-api-identifier

# Auth0 — Management API (M2M) for auto-creating Auth0 users from the admin panel
# Create a Machine-to-Machine application in Auth0, authorize it against the Management API
# with scopes: create:users, create:user_tickets
AUTH0_MGMT_CLIENT_ID=your-m2m-client-id
AUTH0_MGMT_CLIENT_SECRET=your-m2m-client-secret

# Azure SQL Database Configuration (Phase 3 — Azure deployment)
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=
AZURE_SQL_PORT=1433
AZURE_SQL_ENCRYPT=true
